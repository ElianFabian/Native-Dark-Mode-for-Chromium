{
  "manifest_version": 3,
  "name": "Native Dark Mode — Prototype",
  "version": "0.1.0",
  "description": "Per-tab prototype of Chromium native dark mode through CDP.",
  "minimum_chrome_version": "118",
  "permissions": ["debugger", "storage", "activeTab"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Native Dark Mode" }
}
